PORT=3000
NODE_ENV=development

# Base de datos MySQL (MySQL Workbench)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sistema_padel
DB_USER=root
DB_PASSWORD=

# Autenticación JWT y Cookie HTTPOnly
JWT_SECRET=reemplazar_por_un_secreto_seguro_en_env
JWT_EXPIRES_IN=1d
COOKIE_NAME=padel_token
COOKIE_SAME_SITE=lax

# CORS
CLIENT_URL=http://localhost:5173

# Proxy inverso (solo si la app corre detrás de un proxy confiable)
TRUST_PROXY=false

# Destinatario administrativo de avisos (vacío = usa SMTP_USER si es un email válido)
ADMIN_NOTIFY_EMAIL=

# Notificaciones por correo (Nodemailer): dejar SMTP_HOST o SMTP_FROM vacío para deshabilitar
SMTP_HOST=
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=